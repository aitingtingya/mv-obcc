  "files": [
    "lib/*.js"
  ],
  "scripts": {
    "test": "node --test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-tools": "*"
  }
}
