{
  "name": "@mv-aide/mv-dsh-manager",
  "version": "0.1.4",
  "description": "DeepSeek Harness runtime visual management plugin for plugins, skills, and subagents; also provides the recursive slash-command field picker",
  "main": "lib/index.js",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "cordis",
    "plugin",
    "dsh",
    "skills",
    "subagents",
    "manager"
  ],
  "author": "mv-AIDE",
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
